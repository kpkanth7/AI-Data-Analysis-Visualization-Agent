# owner_password: grants unlimited queries in the app (vs guest 5-query limit)
owner_password = "your-secret-password-here"
OPENAI_API_KEY = "sk-..."
DATABASE_URL = "postgresql://<username>@localhost:5432/data_analyst"

# Private pilot settings for app.py (disabled by default) or private_pilot_app.py.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "<random-cookie-secret>"
# client_id = "<OIDC-client-id>"
# client_secret = "<OIDC-client-secret>"
# server_metadata_url = "https://issuer.example/.well-known/openid-configuration"
#
# [private_pilot]
# enabled = false
# issuer = "https://issuer.example"
# registry_url = "postgresql+psycopg2://w1_membership_reader:<password>@localhost:5432/postgres"
#
# [private_pilot.workspaces."00000000-0000-4000-8000-000000000001"]
# reader_url = "postgresql+psycopg2://w_00000000000040008000000000000001_reader:<password>@localhost:5432/postgres"
# writer_url = "postgresql+psycopg2://w_00000000000040008000000000000001_writer:<password>@localhost:5432/postgres"
